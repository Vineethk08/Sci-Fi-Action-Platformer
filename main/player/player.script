local SPEED = 150
local GRAVITY = -1000
local JUMP_SPEED = 370

local AIM_ANGLES = {
	{key = 'up',      angle = 90},
	{key = 'upfwd',   angle = 45},
	{key = 'fwd',     angle = 0},
	{key = 'downfwd', angle = -45},
	{key = 'down',    angle = -90},
}

function init(self)
	self.velocity = vmath.vector3(0, 0, 0)
	self.grounded = false
	self.facing = 'r'
	self.aim_key = 'fwd'
	self.current_anim = ''
	self.mouse = vmath.vector3(0, 0, 0)
	msg.post('.', 'acquire_input_focus')
end

function update(self, dt)
	self.velocity.y = self.velocity.y + GRAVITY * dt
	local pos = go.get_position()
	pos = pos + self.velocity * dt
	go.set_position(pos)
	self.grounded = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash('contact_point_response') then
		if message.normal.y > 0.5 then
			self.grounded = true
			self.velocity.y = 0
		end
		local proj = vmath.dot(self.velocity, message.normal)
		if proj < 0 then
			self.velocity = self.velocity - message.normal * proj
		end
		local pos = go.get_position()
		pos = pos + message.normal * message.distance
		go.set_position(pos)
	end
end

function on_input(self, action_id, action)
	if action_id == hash('left') then
		if action.pressed or action.repeated or action.value == 1 then
			self.velocity.x = -SPEED
			self.facing = 'l'
		elseif action.released then
			self.velocity.x = 0
		end
	elseif action_id == hash('right') then
		if action.pressed or action.repeated or action.value == 1 then
			self.velocity.x = SPEED
			self.facing = 'r'
		elseif action.released then
			self.velocity.x = 0
		end
	elseif action_id == hash('jump') then
		if action.pressed and self.grounded then
			self.velocity.y = JUMP_SPEED
		end
	elseif action_id == hash('shoot') and action.pressed then
		local pos = go.get_position()
		local aim_map = {up=90, upfwd=45, fwd=0, downfwd=-45, down=-90}
		local aim_deg = aim_map[self.aim_key] or 0
		local rad = math.rad(aim_deg)
		local dir = vmath.vector3(math.cos(rad), math.sin(rad), 0)
		if self.facing == 'l' then
			dir.x = -dir.x
		end
		local gun_offset = vmath.vector3(dir.x * 12, dir.y * 12 + 8, 0)
		local angle_rad = math.atan2(dir.y, dir.x)
		local rot = vmath.quat_rotation_z(angle_rad)
		local props = {velocity = dir * 400}
		factory.create('#factory', pos + gun_offset, rot, props)
	end

	if action.x and action.y then
		self.mouse = vmath.vector3(action.x, action.y, 0)
	end

	local pos = go.get_position()
	local dx = self.mouse.x - pos.x
	local dy = self.mouse.y - pos.y

	if self.facing == 'r' and dx < 0 then dx = 0 end
	if self.facing == 'l' and dx > 0 then dx = 0 end

	local angle = math.atan2(dy, math.abs(dx))
	local deg = math.deg(angle)

	if deg > 67.5 then
		self.aim_key = 'up'
	elseif deg > 22.5 then
		self.aim_key = 'upfwd'
	elseif deg > -22.5 then
		self.aim_key = 'fwd'
	elseif deg > -67.5 then
		self.aim_key = 'downfwd'
	else
		self.aim_key = 'down'
	end

	local state = 'stand'
	if not self.grounded then
		state = 'jump'
	elseif math.abs(self.velocity.x) > 0 then
		state = 'run'
	end

	local anim = state .. '_' .. self.facing .. '_' .. self.aim_key
	if anim ~= self.current_anim then
		self.current_anim = anim
		sprite.play_flipbook('#sprite', hash(anim))
	end
end